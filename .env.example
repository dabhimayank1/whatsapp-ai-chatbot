# ---- Copy this file to ".env" and fill your real values ----

# PRIMARY AI: Groq (FREE forever, no credit card, high daily limit - Llama models)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OPTIONAL: Google Gemini - only used as a fallback for reading IMAGES (photos).
# PDFs are read locally for free, so this is not required for document support.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Ensures print()/logs show up immediately on Render (important for debugging)
PYTHONUNBUFFERED=1

# Company / Industry details (used in the welcome message)
COMPANY_NAME=XYZ Industry
WELCOME_MESSAGE=Hello! Welcome to {company}. How can I help you today?

# Twilio (OPTIONAL - only if using Twilio instead of Meta directly; costs money after trial)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta WhatsApp Cloud API (RECOMMENDED - FREE, no Twilio middleman/billing needed)
# Setup: https://developers.facebook.com/ -> create app -> add WhatsApp product
META_ACCESS_TOKEN=your_meta_temporary_or_permanent_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_VERIFY_TOKEN=pick_any_secret_word_yourself

# Where should escalated ("talk to human") chats be flagged/notified
ADMIN_NOTIFY_EMAIL=owner@example.com
