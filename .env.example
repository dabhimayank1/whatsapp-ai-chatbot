# ---- Copy this file to .env and fill in real values ----
#
# The values in here are EXAMPLES and several of them are published in the
# README. Nothing in this file is a usable secret — generate your own.

# Groq — free key, no card: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# ---- Meta app secret — SET THIS FIRST ----
# Meta App Dashboard → Settings → Basic → App Secret.
#
# Every webhook POST from Meta is signed with it. Without it, the /webhook and
# /ig-webhook endpoints cannot tell a real event from a forged one, and anyone
# who learns your URL can make the bot send messages on your tokens. It is also
# what verifies Instagram's data-deletion callback.
META_APP_SECRET=
# Leave this alone. Only ever set it to false for local debugging.
VERIFY_WEBHOOK_SIGNATURE=true

# ---- WhatsApp Cloud API (https://developers.facebook.com) ----
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxx
PHONE_NUMBER_ID=123456789012345
# You invent this, then paste the SAME string into Meta's webhook screen.
# There is no default: unset means the handshake is refused.
WA_VERIFY_TOKEN=
# The number customers message, digits only, with country code. Used in wa.me links.
WA_BUSINESS_NUMBER=919876543210
# Prefixed onto a bare national number typed into the desktop callback form.
DEFAULT_COUNTRY_CODE=91

# ---- WhatsApp message templates ----
# The Cloud API refuses free-form messages more than 24h after the customer's
# last inbound one (error 131047). Business-initiated messages need an approved
# template, created under WhatsApp Manager → Message templates.
#
# WA_ALERT_TEMPLATE matters most: an agent alert goes to your own team, who have
# almost certainly never messaged the business number, so there is no open
# window and a plain text alert simply fails. Body placeholders, in order:
#   {{1}} band  {{2}} score  {{3}} name and number  {{4}} answers  {{5}} link
WA_ALERT_TEMPLATE=
# Optional: used to re-engage a customer whose 24h window has closed. {{1}} is
# the message we wanted to send.
WA_REENGAGE_TEMPLATE=
WA_TEMPLATE_LANG=en
WA_WINDOW_HOURS=24

# ---- Instagram (Instagram Login) ----
# IMPORTANT: IG_TOKEN MUST be a dedicated Instagram Access Token.
# DO NOT use WHATSAPP_TOKEN as IG_TOKEN.
# Required Meta Permissions/Scopes:
#   - instagram_business_basic
#   - instagram_business_manage_comments
#   - instagram_business_manage_messages
IG_TOKEN=
IG_USER_ID=17841400000000000
# Invent your own. No default — unset means the handshake is refused, and it
# must differ from WA_VERIFY_TOKEN.
IG_VERIFY_TOKEN=
IG_GRAPH_HOST=graph.instagram.com

# Public HTTPS base for tracked links. Use your ngrok URL while developing.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---- Tenancy ----
# ON  = one client on this deployment. A webhook event we cannot map to a tenant
#       falls back to the sole active tenant.
# OFF = required as soon as a second client exists. An unmappable event is
#       logged and dropped rather than attributed to the wrong client.
#
# The fallback only ever engages when exactly one tenant is active, so it cannot
# silently misroute — but leave it off unless you need it.
SINGLE_TENANT_MODE=false

# ---- Admin dashboard login ----
ADMIN_USER=admin
# Prefer the hash. Generate one with:
#     npm run hash-password -- 'your-password'
# With neither set, the admin login is disabled rather than defaulting to
# something guessable.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# Signs the session cookie. Set this or everyone is logged out on restart.
SECRET_KEY=
# Send the session cookie over HTTPS only. Defaults on when NODE_ENV=production.
COOKIE_SECURE=
# Set when running behind a proxy (Render, nginx) so rate limits see the real
# client IP instead of the proxy's. Defaults on when NODE_ENV=production.
TRUST_PROXY=

# ---- Logging and privacy ----
# Webhook payloads carry phone numbers, names and message bodies. Turning this
# on writes them to your host's log stream, which you cannot then delete.
LOG_WEBHOOK_PAYLOADS=false
LOG_REDACT_PII=true
# Dedup rows older than this are discarded. Meta stops retrying long before.
PROCESSED_EVENT_RETENTION_DAYS=7

# ---- Business identity: only used as a fallback before any tenant exists ----
BUSINESS_NAME=Skyline Properties
DOMAIN_NAME=real estate and property services

# ---- Storage ----
# On a host without a persistent disk this file is wiped on every deploy. Point
# it at mounted storage in production.
DB_PATH=

# ---- CRM: null | csv | webhook ----
# 'webhook' POSTs lead JSON anywhere — Zoho, HubSpot, Zapier, Make, n8n.
CRM_ADAPTER=csv
CRM_WEBHOOK_URL=

# ---- Rate limits ----
# Meta's practical ceiling is ~200 automated IG DMs/hour/account. Stay under.
IG_SENDS_PER_HOUR=150
WA_SENDS_PER_HOUR=600

# Minutes to wait before nudging someone who clicked but never messaged.
RECOVERY_DELAY_MINUTES=20

# Server port.
PORT=5000
