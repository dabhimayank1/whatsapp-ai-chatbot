# ---- Copy this file to .env and fill in real values ----

# Groq — free key, no card: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# ---- WhatsApp Cloud API (https://developers.facebook.com) ----
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxx
PHONE_NUMBER_ID=123456789012345
# You invent this, then paste the SAME string into Meta's webhook screen.
WA_VERIFY_TOKEN=my-secret-verify-token-123
# The number customers message, digits only, with country code. Used in wa.me links.
WA_BUSINESS_NUMBER=919876543210

# ---- Instagram (Instagram Login, NOT Facebook Login for Business) ----
# Scopes: instagram_business_basic, instagram_business_manage_comments,
#         instagram_business_manage_messages
IG_TOKEN=IGAAxxxxxxxxxxxxxxxxxxxxx
IG_USER_ID=17841400000000000
IG_VERIFY_TOKEN=my-secret-ig-token-456

# Public HTTPS base for tracked links. Use your ngrok URL while developing.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---- Admin dashboard login ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Signs the session cookie. Set this or everyone is logged out on restart.
SECRET_KEY=

# ---- Business identity: only used as a fallback before any tenant exists ----
BUSINESS_NAME=Skyline Properties
DOMAIN_NAME=real estate and property services

# ---- CRM: null | csv | webhook ----
# 'webhook' POSTs lead JSON anywhere — Zoho, HubSpot, Zapier, Make, n8n.
CRM_ADAPTER=csv
CRM_WEBHOOK_URL=

# ---- Rate limits ----
# Meta's practical ceiling is ~200 automated IG DMs/hour/account. Stay under.
IG_SENDS_PER_HOUR=150
WA_SENDS_PER_HOUR=600

# Minutes to wait before nudging someone who clicked but never messaged.
RECOVERY_DELAY_MINUTES=20

# Server port.
PORT=5000
