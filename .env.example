# ---- Copy this file to ".env" and fill your real values ----

# Google Gemini (Claude ki jagah) - FREE, no credit card required
# Free key yahan se lo: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Ensures print()/logs show up immediately on Render (important for debugging)
PYTHONUNBUFFERED=1

# Company / Industry details (used in the welcome message)
COMPANY_NAME=XYZ Industry
WELCOME_MESSAGE=Hello! Welcome to {company}. How can I help you today?

# Twilio (only needed for REAL WhatsApp, not needed for the browser demo)
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Where should escalated ("talk to human") chats be flagged/notified
ADMIN_NOTIFY_EMAIL=owner@example.com
