# ---- Copy this file to ".env" and fill your real values ----

# Anthropic (Claude) API key -> https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Company / Industry details (used in the welcome message)
COMPANY_NAME=XYZ Industry
WELCOME_MESSAGE=Hello! Welcome to {company}. How can I help you today?

# Twilio (only needed for REAL WhatsApp, not needed for the browser demo)
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Where should escalated ("talk to human") chats be flagged/notified
ADMIN_NOTIFY_EMAIL=owner@example.com
